@prefix : <http://www.semanticweb.org/vs/ontologies/2025/12/incubator#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdt: <http://www.semanticweb.org/ivans/ontologies/2025/ruleless-digital-twins/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

: owl:imports rdt: .

:IncubatorTest a owl:NamedIndividual,
        sosa:Platform ;
    rdt:generateCombinationsOnlyFromOptimalConditions false ;
    rdt:hasSimulationModel :Incubator_FMU ;
    sosa:hosts :FanActuator,
        :HeaterActuator,
        :TempSensor ;
    ssn:implements :oc_temp .

:in_room_temperature a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdt:hasValue 0e+00 .

:FanActuator a owl:NamedIndividual,
        sosa:Actuator ;
    rdt:hasActuatorState 1 .

:HeaterActuator a owl:NamedIndividual,
        sosa:Actuator ;
    rdt:enacts :HeaterChange ;
    rdt:hasActuatorName "in_heater_state"^^xsd:string ;
    rdt:hasActuatorState 0,
        1 .

:HeaterChange a rdt:PropertyChangeByActuation,
        owl:NamedIndividual ;
    rdt:affectsPropertyWith rdt:ValueIncrease ;
    ssn:forProperty :T .

:Incubator_FMU a rdt:FmuModel ;
    rdt:hasSimulationFidelitySeconds 3 ;
    rdt:hasURI "au_incubator.fmu"^^xsd:anyURI .

:TempMeasure a owl:NamedIndividual,
        ssn:Output,
        ssn:Property ;
    rdt:hasValue 0e+00 .

:TempProcedure a owl:NamedIndividual,
        sosa:Procedure ;
    ssn:hasOutput :TempMeasure .

:TempSensor a owl:NamedIndividual,
        sosa:Sensor ;
    sosa:observes :T ;
    ssn:implements :TempProcedure .

:TemperatureLowerLimit a owl:NamedIndividual,
        ssn:Property ;
    rdt:hasValue 3e+01 .

:TemperatureUpperLimit a owl:NamedIndividual,
        ssn:Property ;
    rdt:hasValue 3.5e+01 .

:oc_temp a [ a owl:Restriction ;
            owl:onClass [ a owl:Class ;
                    owl:intersectionOf ( [ a owl:Restriction ;
                                owl:hasValue :TemperatureLowerLimit ;
                                owl:onProperty rdt:greaterThan ] [ a owl:Restriction ;
                                owl:hasValue :TemperatureUpperLimit ;
                                owl:onProperty rdt:lessThan ] ) ] ;
            owl:onProperty rdt:hasConstraint ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        rdt:OptimalCondition,
        owl:NamedIndividual ;
    rdt:isBreakable true ;
    ssn:forProperty :T .

:T a owl:NamedIndividual,
        sosa:ObservableProperty ;
    rdt:hasValue 0e+00 .


