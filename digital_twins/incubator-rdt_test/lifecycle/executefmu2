#!/bin/bash

build_fmu() {
    SOURCE_DIR="$1"
    FMU_FILE="$2"
    BUILD_DIR="$(mktemp -d "/tmp/fmu-build.XXXXXX")"

    source /tmp/rdt-lifecycle-venv/bin/activate

    cp -R "$SOURCE_DIR/." "$BUILD_DIR/"

    cd "$BUILD_DIR"
    make clean
    make all

    cp "$FMU_FILE" "$SOURCE_DIR/.."

    rm -rf "$BUILD_DIR"
}
build_fmu "/workspace/RDT/Workspace1/Model/Fakepool-FMU" "Fakepool.fmu"
build_fmu "/workspace/RDT/Workspace1/Model/Nordpool-FMU" "NordPool.fmu"
build_fmu "/workspace/RDT/Workspace1/Model/Yr-Weather-FMU" "YrWeather.fmu"
